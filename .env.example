# Copy this file to .env and change values for your machine. .env is never committed.
# Port the API listens on
PORT=3000
# Password for the local Postgres container (docker compose reads this too)
DB_PASSWORD=devpass123
# Main database, used by the app and by `npm run migrate`
DATABASE_URL=postgres://canteen:devpass123@localhost:5432/canteen
# Separate, disposable database used ONLY by integration tests
TEST_DATABASE_URL=postgres://canteen:devpass123@localhost:5432/canteen_test